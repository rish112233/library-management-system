# Server Port
PORT=5000

# MongoDB Connection String (Local or MongoDB Atlas)
# Example Local: mongodb://127.0.0.1:27017/library_management
# Example Atlas: mongodb+srv://<username>:<password>@cluster0.mongodb.net/library_management?retryWrites=true&w=majority
MONGO_URI=mongodb://127.0.0.1:27017/library_management

# JSON Web Token Secret
JWT_SECRET=your_jwt_secret_key_change_in_production

# Optional: Allowed Frontend Origin(s) separated by comma (for CORS)
CLIENT_URL=http://localhost:5173

# Node Environment (development | production)
NODE_ENV=development
